# ETF Pulse Analytics optional live-data providers
# Copy this file to .env.local and fill in only the providers you want to enable.

# Twelve Data: quotes, daily history, price-derived returns and volatility
TWELVE_DATA_API_KEY=

# Alpha Vantage: ETF profile, AUM, expense ratio, holdings and sector allocation
ALPHA_VANTAGE_API_KEY=

# BusinessQuant: SEC-filed monthly ETF/mutual-fund flows
BUSINESSQUANT_API_KEY=
